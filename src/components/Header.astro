---
import { Image } from 'astro:assets';
import logoUnivalle from '@assets/logo.png';
import { ExternalLink } from 'lucide-react';
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-100 px-4 sm:px-8 py-4">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Marca -->
    <a 
      href="https://www.univalle.edu/" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="flex items-center gap-3 text-rose-900 font-black text-xl tracking-tight hover:opacity-90 transition-opacity"
    >
      <Image
        src={logoUnivalle}
        alt="Logo Univalle"
        class="h-8 w-auto object-contain"
      />
    </a>

    <!-- Botón SIU -->
    <a
      href="https://enlace.univalle.edu/san/webform/PAutenticar.aspx"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-rose-50 border border-rose-200/80 text-rose-900 font-bold hover:bg-rose-100 transition-colors text-sm"
    >
      <span>SIU</span>
      <ExternalLink className="w-3.5 h-3.5 text-rose-700" />
    </a>
  </div>
</header>
