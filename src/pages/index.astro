---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import PageLoader from '@components/PageLoader.jsx';
import BentoFAQ from '@components/BentoFAQ.jsx';
---

<Layout title="Centro de Ayuda Estudiantil - Univalle Sucre">

  <PageLoader client:load logoPath="/logo.png" />

  <Header />

  <!-- Sección Hero a Pantalla Completa -->
  <div class="relative min-h-[calc(100vh-73px)] w-full flex items-center justify-center px-3 py-8 sm:py-12 overflow-hidden">

    <!-- Imagen de fondo base -->
    <img
      src="https://images.unsplash.com/photo-1562774053-701939374585?q=80&w=1920&auto=format&fit=crop"
      alt="Campus Univalle Sucre"
      loading="eager"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover -z-20"
    />

    <!-- Backdrop Filter Blur (Desenfoque de fondo en pantalla completa) -->
    <div class="absolute inset-0 backdrop-blur-xl bg-slate-950/50 -z-10"></div>

    <!-- Contenedor Bento Grid -->
    <main class="w-full my-auto z-10">
      <BentoFAQ client:load />
    </main>
  </div>
</Layout>
